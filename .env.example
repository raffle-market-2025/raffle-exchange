# Локальная разработка. Реальные значения — только в хранилище секретов (ADR-0004).
# Отдельная БД обмена: не переиспользовать БД, ключи и кошельки розыгрышей (EX-039).
DATABASE_URL=postgresql://exchange:exchange_local@localhost:5433/raffle_exchange?schema=exchange
POSTGRES_PASSWORD=exchange_local

EXCHANGE_API_PORT=3100
LOG_LEVEL=info

# Масштаб сумм по активу (02 §10). USDT уточняется по Walt на этапе A; пусто = сервис не стартует.
ASSET_SCALE_UAH=2
ASSET_SCALE_USDT=
