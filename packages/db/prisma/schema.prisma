// Отдельная БД обмена, схема `exchange` (ADR-0001, 02 §10).
// Модели добавляет только владелец схемы (трек 1) до гейта G1; затем — через ревью (docs/stage-b-plan.md).
//
// Правила для будущих моделей:
// - суммы: Decimal (numeric) с явным масштабом; Float запрещён;
// - время: DateTime @db.Timestamptz(6), внутри UTC;
// - денежные инварианты, которые Prisma не выражает (CHECK, частичные unique,
//   отложенный триггер баланса журнала), пишутся сырым SQL в миграции (ADR-0003);
// - состояния хранятся кодами, независимыми от языка интерфейса.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
