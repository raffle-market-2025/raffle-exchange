{
  "name": "@raffle-exchange/db",
  "version": "0.0.0",
  "private": true,
  "description": "Схема и миграции отдельной БД обмена (ADR-0001, ADR-0003). Модели появляются к гейту G1.",
  "scripts": {
    "validate": "DATABASE_URL=${DATABASE_URL:-postgresql://validate:validate@localhost:5433/validate} prisma validate --schema prisma/schema.prisma",
    "format": "prisma format --schema prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
